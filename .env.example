# Local development only. Do not commit your real .env file.
DEBUG=True
DJANGO_USE_SQLITE=True
DJANGO_SECRET_KEY=replace-with-a-long-local-development-secret
PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001
BACKEND_PUBLIC_URL=http://localhost:8000
LOG_LEVEL=INFO

# Local seed data intentionally does not send email. Leave these empty.
RESEND_API_KEY=
ADMIN_EMAILS=

# SMTP is not required for the local portfolio/admin workflow.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Production / Railway PostgreSQL configuration. Leave unset for local SQLite.
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# PGHOST=
# PGPORT=5432
